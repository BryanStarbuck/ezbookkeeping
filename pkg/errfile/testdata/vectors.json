 "normalise": {
  "_comment": "Applied in this order to the message before it becomes part of the fold key; then cut to fold_key_message chars. Same regex syntax in Go (RE2) and JS.",
  "steps": [
   {
    "name": "uuid",
    "regex": "[0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[0-9a-fA-F]{4}-[0-9a-fA-F]{4}-[0-9a-fA-F]{12}",
    "replace": "<uuid>"
   },
   {
    "name": "path",
    "regex": "(?:/[A-Za-z0-9_.\\-]+){2,}",
    "replace": "<path>"
   },
   {
    "name": "hex",
    "regex": "\\b[0-9a-fA-F]{8,}\\b",
    "replace": "<hex>"
   },
   {
    "name": "digits",
    "regex": "[0-9]+",
    "replace": "#"
   }
  ]
 },
 "control_chars_regex": "[\\x00-\\x1f\\x7f\\u2028\\u2029]",
 "secret_key_regex": "(?i)pass(word)?|secret|token|auth|cookie|session|key|signature|credential|bearer|totp|otp|passcode",
 "ledger_key_regex": "(?i)amount|balance|payee|comment|notes?|memo|account_?name|category_?name|tag_?name|description|statement|iban|card|number",
 "url_query_redact_params": [
  "token",
  "code",
  "state",
  "key",
