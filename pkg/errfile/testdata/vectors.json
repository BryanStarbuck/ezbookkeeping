 "_comment": "Cross-language behaviour vectors for pkg/errfile (Go) and src/lib/errfile (TS). Synthetic data only. See pm/error_err.mdx section 15.4. Both test suites read this file; a change here is a spec change.",
 "line_format": "[<ts>] [<LEVEL>] [<app>] [<where>] <doing> — <Type>: <message>( (<k>=<v> ...))?( {<k>=<v> ...})?( | cause: <Type>: <message>( (<k>=<v>))?)*  then stack lines each '    at <frame>'",
 "paths": [
  {
   "name": "default",
   "env": {
    "HOME": "/home/operator"
   },
   "test": false,
   "expect": "/home/operator/T/ezbookkeeping/error.err"
  },
  {
   "name": "override wins",
   "env": {
    "HOME": "/home/operator",
    "EZBK_ERROR_FILE": "/var/tmp/ezbk/error.err"
   },
   "test": false,
   "expect": "/var/tmp/ezbk/error.err"
  },
  {
   "name": "override wins even in tests",
   "env": {
    "HOME": "/home/operator",
    "EZBK_ERROR_FILE": "/var/tmp/ezbk/error.err"
   },
   "test": true,
   "expect": "/var/tmp/ezbk/error.err"
  },
  {
   "name": "tests never write the real file",
   "env": {
    "HOME": "/home/operator",
    "TMPDIR": "/tmp"
   },
   "test": true,
   "uid": 501,
   "expect": "/tmp/ezbookkeeping_test_501/error.err"
  },
  {
   "name": "no home directory",
   "env": {
    "TMPDIR": "/tmp"
   },
   "test": false,
   "uid": 501,
   "expect": "/tmp/ezbookkeeping_501/error.err"
  }
 ],
